<configuration>
    <springProperty name="APPLICATION_NAME" source="spring.application.name"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{dd.MM.yyyy hh:mm:ss.SSS} [${APPLICATION_NAME}, %thread] %level - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <springProfile name="dev">
        <logger name="org.pokubuy" level="trace"/>
    </springProfile>
</configuration>